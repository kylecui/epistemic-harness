# 复制为 .env 并在启动 ./scripts/start_proxy.sh 前 source .env
# 主力池 1：智谱 V2 最高级 CodingPlan (glm-5.3 / glm-5.3-flash)
ZHIPU_API_KEY="your-zhipu-key"
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/coding/paas/v4"

# 主力池 2：Kimi Allegretto (k3.1-pro / kimi-for-coding)
KIMI_API_KEY="your-kimi-key"
KIMI_BASE_URL="https://api.kimi.com/coding/v1"
KIMI_CODING_BASE_URL="https://api.kimi.com/coding/v1"

# 主力池 3：OpenCode Go 基本版 (deepseek-v4.1-flash)
OPENCODE_GO_API_KEY="your-opencode-go-key"
OPENCODE_GO_BASE_URL="https://opencode.ai/inference/go/v1"

# 末位兜底池（last_option: true — 仅在前三套全部耗尽/429 时调用）
GITHUB_COPILOT_TOKEN="your-copilot-token"
GITHUB_COPILOT_BASE_URL="https://api.githubcopilot.com"
GEMINI_API_KEY="your-google-ai-pro-key"
GOOGLE_AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
