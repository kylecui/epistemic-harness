{
  "enabled": true,
  "max_gate_retries": 3,
  "command_timeout_ms": 60000,
  "checks": [
    {
      "name": "unit_tests",
      "command": "python scripts/select_tests.py --docker --policy",
      "required": true
    }
  ],
  "residue_globs": [
    "*.tmp",
    "*.bak",
    "*.orig",
    "debug_*.py",
    "scratch_*",
    "tmp_*",
    ".*tmp*",
    ".*scratch*",
    ".*debug*",
    ".*.bak",
    ".*.orig"
  ],
  "bypass_phrases": [
    "skip exit gate",
    "跳过验收",
    "先不跑测试"
  ],
  "evidence_policy": "enforce",
  "gate_runner": "auto",
  "verify_image": "epistemic-verify:local"
}
